// multi_channel_image.fbs

namespace airbot_fbs;

// 定义支持的数据类型枚举，以便在运行时知道如何解释数据
enum DataType: byte {
    UNKNOWN = 0,
    UINT8 = 1,
    INT8 = 2,
    UINT16 = 3,
    INT16 = 4,
    FLOAT32 = 5,
    FLOAT64 = 6
}

// 固定长度数组必须定义在 struct 中，不能直接放在 table 里
struct ImageShape {
    dims: [uint32:3];
}

// 主表结构
table MultiChannelImage {
    // 图像维度 [高度, 宽度, 通道数]
    shape: ImageShape;
    
    // 数据类型
    dtype: DataType;
    
    // 原始像素数据 (展平为一维数组)
    // 大小应为 shape[0] * shape[1] * shape[2] * element_size
    data: [ubyte]; 
}

// 根对象
root_type MultiChannelImage;
